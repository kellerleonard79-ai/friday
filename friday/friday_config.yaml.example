# Project Friday — configuration template.
#
# Copy to friday_config.yaml and fill in. That file is gitignored: it holds
# live tokens. See the README for how to obtain each credential.
#
# On macOS (source checkout) this file lives next to friday.py.
# On Windows / any frozen build it lives in %APPDATA%\Friday\.
#
# Startup hard-fails only on: telegram.bot_token, telegram.chat_id, and a
# Gemini key when provider is gemini. Every other block is optional — an
# unconfigured connector is skipped, not an error.

agent:
  name: Friday
  morning_briefing_time: '07:00'
  briefing_time: '21:45'            # evening briefing
  timezone: America/Chicago         # IANA name; drives both briefing schedules

  # How late a missed briefing may still be delivered after a sleep/outage.
  briefing_catchup_max_minutes: 120

  # How long a permission card stays tappable. A day, because "I'll deal with
  # that in the morning" is ordinary and a card sent at 11pm has to survive
  # until 8am. Not indefinite: a week-old button that still writes to the
  # calendar is not a permission gate, it is a landmine. A tap past the TTL is
  # refused with a message, never honoured and never silently ignored.
  pending_action_ttl_minutes: 1440

  # How long ONE TAP is enough for. Past this the card still works, but it is
  # re-proposed as a fresh card and the user confirms that one instead — so
  # the second confirmation is a tap on a different button, which a reflexive
  # double-tap cannot supply. Shortening the TTL instead would trade the real
  # overnight case for this one; two thresholds cost nothing and keep both.
  pending_action_stale_minutes: 30

  # Fallback calendar used when a write target doesn't exist (e.g. Canvas
  # auto-sync with no 'Canvas' calendar present). macOS exposes no scriptable
  # "default calendar", so this must be explicit.
  default_calendar: 'Keller Leonard'

  # Whitelist of calendar names to include in briefings. Leave empty to
  # include all calendars except 'Siri Suggestions' and 'US Holidays'.
  briefing_calendars:
    - Keller Leonard
    - Work
    - Family

telegram:
  bot_token: ''       # from @BotFather. Env fallback: TELEGRAM_BOT_TOKEN
  chat_id: ''         # your personal chat ID — a NUMBER (negative for a group),
                      # not the bot's @username. A username here is accepted at
                      # startup and then 403s on the first send.
                      # Env fallback: TELEGRAM_CHAT_ID

memory:
  db_path: memory/friday_memory.db  # relative paths resolve against the data dir
  short_term_turns: 20              # rolling conversation window

provider: ollama      # ollama | gemini

ollama:
  model: llama3.2:1b
  base_url: http://localhost:11434
  max_tokens: 1000

gemini:
  model: gemini-3.6-flash   # fallback for any profile without its own entry
  api_key: ''         # env fallback: GEMINI_API_KEY

# Per-profile model and spend. A profile is a calling convention; which model
# implements it is tuning. Anything omitted falls back to the provider block
# above, so a config predating this block still boots.
#
# These are Gemini model names. On `provider: ollama` they are wrong and the
# call fails loudly at first use — set ollama model names here or delete the
# block to fall back to ollama.model.
#
# CLASSIFY and COMPOSE have no caller yet. Their entries are inert until the
# code table names them.
profiles:
  CHAT:
    # DEVELOPMENT-TIME CONSTRAINT, NOT A DESIGN DECISION. The free tier gives
    # gemini-3.6-flash 20 requests/day, which cannot verify a step that needs
    # dozens of tool-calling turns. Return CHAT to gemini-3.6-flash when
    # billing is enabled — extraction quality at call #1 is final, and this is
    # the profile that extracts tool arguments.
    model: gemini-3.5-flash-lite
    max_output_tokens: 1024
    temperature: 1.0
  COMPOSE:                          # briefings
    model: gemini-3.6-flash
    max_output_tokens: 2048
    temperature: 1.0
  CLASSIFY:                         # urgency tagging — one label, no prose
    model: gemini-3.5-flash-lite
    max_output_tokens: 64
    temperature: 0.0

# Calendar backend — the event store. Defaults to google on Windows and
# apple everywhere else; set explicitly to override.
calendar:
  backend: apple      # apple (macOS, JXA) | google (Calendar API + OAuth)
  google:
    auto_create: true # create missing calendars (google backend only;
                      # the apple backend never creates calendars)

canvas:
  ical_url: ''        # Canvas → Calendar → "Calendar Feed"
  api_token: ''       # optional. Canvas → Account → Settings →
                      # "+ New Access Token". The feed URL works without it;
                      # with it, a rejected fetch reports 401/403 instead of
                      # looking like an empty week. Full account access — treat
                      # it like a password.
                      #
                      # THIS TOKEN EXPIRES — Canvas sets an expiry and school
                      # accounts are often capped at a term. When it lapses the
                      # iCal feed keeps working (its URL carries its own
                      # secret), so Friday keeps the course list and due DAYS
                      # and loses only the due TIME, points and submission
                      # status. The dashboard shows which layer is live.
  base_url: ''        # optional. e.g. https://yourschool.instructure.com
                      # Only needed if the REST host differs from the iCal
                      # URL's origin, which is derived automatically.

# The bell schedule, and the A/B rotation. Powers the dashboard's period card.
# Edit the times here or through the dashboard's Schedule tab; assign courses
# with the picker there rather than by hand (it lists your real Canvas ids).
schedule:
  bedtime: '23:00'    # the far end of the after-school card's free-time math
  periods:
    # canvas_course is a Canvas course id, as a string. null = no course, which
    # is a valid state (lunch, study hall, an elective Canvas does not carry).
    - {n: 1, start: '08:00', end: '08:50', canvas_course: null}
    - {n: 2, start: '08:55', end: '09:45', canvas_course: null}
    - {n: 3, start: '09:50', end: '10:40', canvas_course: null}
    # 4th and 5th alternate. `alternates` is [A-day course, B-day course].
    - {n: 4, start: '10:45', end: '11:35', alternates: [null, null]}
    - {n: 5, start: '12:20', end: '13:10', alternates: [null, null]}
    - {n: 6, start: '13:15', end: '14:05', canvas_course: null}
    - {n: 7, start: '14:10', end: '15:00', canvas_course: null}
  ab_cycle:
    start_date: null  # the first A day, ISO YYYY-MM-DD. While this is null the
                      # card shows BOTH courses for 4th and 5th, labeled A and
                      # B, rather than guessing which one is today.
    pattern: [A, B]
    manual_override: null       # 'A' or 'B' — forces today's letter and
                                # EXPIRES AT MIDNIGHT. For assemblies, late
                                # starts and exam weeks, which break the
                                # rotation constantly.
    manual_override_date: null  # set automatically alongside the override;
                                # it is what makes the expiry real.
                      #
                      # The rotation advances by SCHOOL DAYS, not calendar
                      # parity — every weekday counts. There is no holiday
                      # calendar and there should not be one; use the manual
                      # override when the school drifts.

weather:
  api_key: ''                 # OpenWeatherMap. Env fallback: WEATHER_API_KEY
  location: ''                # "City,CC" format, e.g. Austin,US. Fallback only —
                              # used when use_machine_location is false, or when
                              # it's true but connectors/location.py has no fix
                              # cached yet. Env fallback: WEATHER_LOCATION
  use_machine_location: true  # prefer the Mac's own location (connectors/location.py)
                              # over the string above. false pins the string —
                              # for a machine that travels, or a fixed answer.

groupme:
  api_token: ''       # from dev.groupme.com → "Access Token"
  # Each entry needs an id OR a name (names resolve via the API).
  # priority tiers — see connectors/groupme.py:
  #   high   → can interrupt immediately, and appears in briefings
  #   normal → appears in briefings only, never interrupts
  #   muted  → ingested for history, never surfaced
  # ('low' is the legacy spelling and is read as 'muted'.)
  # enabled: false stops polling the group entirely. Omit it to mean true.
  # Re-enabling resumes from the newest message — no backfill of the gap.
  groups:
    - name: ''
      id: ''
      priority: high
      enabled: true
    - name: ''
      id: ''
      priority: normal
      enabled: true

# Mirror Google Calendar iCal subscriptions into same-named Apple Calendars.
# One-way (Google → Apple), no approval gate. Skipped on the google backend.
# Create each Apple Calendar manually first — names must match exactly.
# Secret iCal URLs are credentials: Google Calendar → calendar settings →
# "Integrate calendar" → "Secret address in iCal format".
gcal_sync:
  calendars:
    - name: PHS SGA
      ical_url: ''
    - name: FBLA Officer Calendar
      ical_url: ''
    - name: Keller Leonard
      ical_url: ''

# Dashboard-facing mirror. The agent block above stays canonical for the
# JobQueue — if the two disagree, agent wins at runtime. Written lazily by
# the dashboard on first load if absent.
notifications:
  morning_briefing:
    enabled: true
    time: '07:00'
  evening_briefing:
    enabled: true
    time: '21:45'
  proactive_reminders: true
  urgent_interrupts: true
  canvas_polling: true
  groupme_polling: true
  reminder_thresholds: [5, 3, 1]    # days before a due date

# Voice satellite (macOS only). Read by voice/listen.py, which is standalone
# and never imported by friday.py. A running listen.py does NOT reload this —
# restart it: launchctl kickstart -k gui/$(id -u)/com.friday.voice
#
# wake_enabled/clap_enabled true = always-on mic stream (orange indicator lit
# at idle). Both false = push-to-talk only, mic opened per session.
#
# wake_enabled only sets the state at boot. Live, with no restart, a triple
# tap of wake_toggle_key (wake_toggle_tap_count presses within
# wake_toggle_window_ms of each other) flips wake word on or off — including
# turning it on from a cold voice.wake_enabled=false boot, lazily loading the
# detector the first time it's needed.
voice:
  enabled: true
  mic_enabled: true
  wake_enabled: false
  clap_enabled: false
  always_speak: false
  whisper_model: base               # whisper model size
  push_to_talk_key: right_option
  wake_toggle_key: left_option      # triple-tap this to toggle wake word live
  wake_toggle_tap_count: 3
  wake_toggle_window_ms: 600
  tts_voice: Daniel
  silence_ms: 1500
  max_recording_ms: 30000
  wake_phrases:
    - Hey Friday
    - Friday you up
    - Friday

gmail:
  # Deprioritized — no accessible API path for locked-down school accounts.
  # Present so the config shape stays stable; not implemented.
  credentials_path: gmail_credentials.json
  token_path: gmail_token.json

# ── Dashboard ────────────────────────────────────────────────────────────────
dashboard:
  # Shared access token. EVERY route requires it — the page, the config
  # endpoint (which returns your bot token and API key), the event stream, and
  # the permission-card endpoints that write to your calendar.
  #
  # Leave it out and one is generated on first boot, written back here, and
  # printed to the log once as a ready-made link:
  #
  #     http://127.0.0.1:5174/?token=...
  #
  # Open that link once per device. It sets a cookie that lasts a year; the
  # token never appears in the address bar afterwards. There is no way to turn
  # auth off, on purpose: the bind address is loopback today and will not
  # always be, and a dashboard with auth disabled is a dashboard that is open
  # the moment that changes.
  auth_token: ''

# ── Markets ──────────────────────────────────────────────────────────────────
# The dashboard's markets widget. Keyless — quotes come from Yahoo's public
# chart endpoint, so there is nothing to sign up for and no secret here.
# Symbols are Yahoo's: AAPL, BRK.B, ^GSPC (an index), BTC-USD (crypto),
# ES=F (a future). Twelve maximum; the widget is a glance, not a portfolio.
stocks:
  enabled: true
  tickers:
    - AAPL
    - MSFT
    - NVDA
    - GOOGL
    - TSLA
    - SPY

# ── Wake schedule ────────────────────────────────────────────────────────────
# Scheduling the Mac awake so it is not asleep when Friday has something to do.
# macOS makes this two separate mechanisms, and they need two separate sudoers
# permissions — see the ONE-TIME SETUP panel on the dashboard's Wake Schedule
# page for the exact line, which Friday reports but never installs:
#
#   waking a sleeping Mac   →  pmset schedule wakeorpoweron / cancel
#   holding it awake        →  pmset -a disablesleep 0 / 1
#
# THEY FAIL INDEPENDENTLY. Granting only the first is a real and useful state:
# scheduled wakes fire, the machine comes up, and it sleeps again on its own
# idle timer instead of being held. The dashboard reports the two halves
# separately for that reason.
wake_schedule:

  # ── Briefing wakes: the primary use, on by default ──
  # For each scheduled briefing time (agent.morning_briefing_time and
  # agent.briefing_time), wake the machine a few minutes early. The hold is
  # released the moment the briefing actually sends — Friday reads the same
  # `last_<slot>_briefing_sent` flag the missed-briefing catch-up net reads,
  # so there is one source of truth and the Mac goes straight back to sleep
  # rather than staying up for a fixed window.
  #
  # A briefing delivered by one of these wakes will NOT also fire as a
  # catch-up when the lid is opened later: the on-time run claims that same
  # flag before it starts composing, and catch-up skips any slot already
  # marked sent for today.
  briefing_wakes: true
  briefing_lead_minutes: 2

  # How long to keep holding if the briefing never sends (Telegram down, a
  # compose that throws). The hold normally ends when it sends; this is the
  # upper bound so a failed briefing cannot hold the machine awake all day.
  briefing_hold_grace_minutes: 10

  # ── Passing-period blocks: opt-in, off by default ──
  # Keeps the Mac reachable with the lid shut during the gaps between class
  # periods, derived from the `schedule:` block above. Off by default because
  # it is the half that costs real battery — seven holds a day rather than
  # two. Turning it off does not affect briefing wakes.
  enabled: false

  # Wake this many minutes before a block starts, so the hold is already in
  # effect by the time the machine is up.
  lead_minutes: 2

  # A gap longer than this is lunch or a free period, not a passing period.
  max_passing_minutes: 15

  # pmset has no repeating multi-event schedule, so wakes are materialized as
  # one-off entries by a daily job. This is how far ahead it works.
  wake_days_ahead: 3

  # Per-derived-block opt-outs, keyed "HH:MM-HH:MM" (the block's own start and
  # end). Read-only on the dashboard — the blocks follow the bell schedule.
  derived_overrides: {}

  # Anything beyond the derived passing periods. `weekdays` is a list of
  # Python weekday numbers (Monday=0); null or absent means every day.
  #   - label: After school
  #     start: '15:05'
  #     end: '15:20'
  #     enabled: true
  #     weekdays: [0, 1, 2, 3, 4]
  custom_blocks: []
